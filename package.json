{
  "name": "three-body-simulations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite --host 127.0.0.1",
    "dev:lan": "npm run wasm && vite --host 0.0.0.0 --mode lan",
    "build": "npm run wasm && node scripts/build-notices.mjs && tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:lan": "vite preview --host 0.0.0.0 --mode lan",
    "test": "go test ./... && npm run wasm && node scripts/test-wasm.mjs",
    "test:browser": "playwright test",
    "share-card": "node scripts/share-card.mjs",
    "format": "prettier --write web scripts tests public/worker.js *.json *.ts index.html",
    "format:check": "prettier --check web scripts tests public/worker.js *.json *.ts index.html"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
